{
  "description": "Sound notifications: Stop = turn finished, PermissionRequest = Claude is waiting for approval.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" stop",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/play-sound.sh\" permission",
            "async": true,
            "timeout": 10
          }
        ]
      }
    ]
  }
}
